# Copy to .env and edit. Default backend is fully local & free (Ollama).

# openai | gemini | ollama | hf
BACKEND=ollama

# --- if BACKEND=openai or hf ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- if BACKEND=gemini (free tier, no credit card; use this on Streamlit Cloud) ---
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=models/text-embedding-004

# --- if BACKEND=ollama (local, free) ---
# Install from https://ollama.com then:  ollama pull llama3.1:8b && ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- retrieval: hybrid + reranker ---
USE_HYBRID=true
USE_RERANKER=true
RERANKER_MODEL=BAAI/bge-reranker-base
DENSE_K=8
BM25_K=8
TOP_K=4

# --- generation ---
ANSWER_LANGUAGE=English
